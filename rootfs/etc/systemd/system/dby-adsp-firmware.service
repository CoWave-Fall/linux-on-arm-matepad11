[Unit]
Description=DBY-W09 ADSP (audio DSP) firmware load
# 固件放在 SD 卡根文件系统，内核在挂载根之前就会 probe，首次加载必然失败，
# 因此在根文件系统就绪后重新绑定一次。
After=local-fs.target
Wants=local-fs.target

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/bin/sh -c 'echo 17300000.remoteproc > /sys/bus/platform/drivers/qcom_q6v5_pas/unbind'
ExecStart=/bin/sh -c 'echo 17300000.remoteproc > /sys/bus/platform/drivers/qcom_q6v5_pas/bind'
ExecStartPost=/bin/sh -c 'for i in $(seq 1 20); do for d in /sys/class/remoteproc/remoteproc*/; do [ "$(readlink -f "$d/device")" = "/sys/devices/platform/soc@0/17300000.remoteproc" ] && [ "$(cat "$d/state")" = running ] && exit 0; done; sleep 1; done; exit 1'

[Install]
WantedBy=multi-user.target
