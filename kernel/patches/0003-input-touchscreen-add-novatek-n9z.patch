+++ b/drivers/input/touchscreen/novatek-n9z-afe.c
@@ -0,0 +1,748 @@
+// SPDX-License-Identifier: GPL-2.0-only
+/*
+ * Novatek N9Z 系列 AFE 帧解算与输入上报。
+ *
+ * 每个 AFE 帧包含 1598 个电容节点，按 32 列 × 50 行排列。驱动逐节点
+ * 相对基线求差，按阈值划分连通区域，用信号强度加权质心得到触点
+ * 位置，再换算成面板像素坐标并通过多点触控接口上报。
+ *
+ * 帧前 4 字节状态字不属于节点流。早期实现把它当作节点 0、1，导致所有
+ * 坐标整体偏移约两列，表现为触摸区域偏向右下；这里从帧偏移 6 开始
+ * 读取节点，节点位置即为物理列行。
+ */
+
+#include <linux/bitmap.h>
+#include <linux/device.h>
+#include <linux/input.h>
+#include <linux/input/mt.h>
+#include <linux/jiffies.h>
+#include <linux/math.h>
+#include <linux/math64.h>
+#include <linux/module.h>
+#include <linux/property.h>
+#include <linux/spi/spi.h>
+#include <linux/unaligned.h>
+
+#include "novatek-n9z.h"
+
+static unsigned int threshold = 0x400;
+module_param(threshold, uint, 0644);
+MODULE_PARM_DESC(threshold, "触点判定阈值，节点相对基线的偏移量");
+
+static bool swap_xy;
+module_param(swap_xy, bool, 0644);
+MODULE_PARM_DESC(swap_xy, "交换行列轴");
+
+static bool invert_x;
+module_param(invert_x, bool, 0644);
+MODULE_PARM_DESC(invert_x, "反转 X 轴");
+
+static bool invert_y;
+module_param(invert_y, bool, 0644);
+MODULE_PARM_DESC(invert_y, "反转 Y 轴");
+
+/*
+ * 手掌与握持抑制。整掌按在面板上时固件会把它拆成多个小区域，
+ * 单个面积与手指接近，因此用“同时触点数量”作为主要判据。
+ */
+static unsigned int palm_area = 10;
+module_param(palm_area, uint, 0644);
+MODULE_PARM_DESC(palm_area, "单个区域达到该节点数即判为手掌，0 关闭");
+
+static unsigned int palm_edge_area = 20;
+module_param(palm_edge_area, uint, 0644);
+MODULE_PARM_DESC(palm_edge_area, "位于边缘附近时判为手掌的节点数，0 关闭");
+
+static unsigned int palm_edge_margin = 4;
+module_param(palm_edge_margin, uint, 0644);
+MODULE_PARM_DESC(palm_edge_margin, "边缘判定的行列节点距离");
+
+static unsigned int palm_max_contacts = 5;
+module_param(palm_max_contacts, uint, 0644);
+MODULE_PARM_DESC(palm_max_contacts, "同时触点超过该数量时整帧丢弃，0 关闭");
+
+/*
+ * 触摸右边缘时固件会在第 0 列产生一个单节点鬼影，与真实触点同一行。
+ * 该区域位于显示区之外，按面积与列号直接丢弃。
+ */
+static unsigned int edge_ghost_area = 6;
+module_param(edge_ghost_area, uint, 0644);
+MODULE_PARM_DESC(edge_ghost_area, "第 0 列鬼影触点的最大节点数，0 关闭");
+
+/*
+ * 状态字是否表明 AFE 正在输出电容帧。固件处于 bootloader 或 AFE 任务
+ * 尚未启动时，读命令由 SRAM 通路应答，状态字为 40 00 00 00 一类数据，
+ * 过不了校验和。
+ */
+bool nvt_status_valid(const u8 *buf)
+{
+	/*
+	 * 前 2 字节为 SPI 哑字节，随后是 4 字节状态字。byte2 的 bit6
+	 * 是 AFE 帧标志，其余位随扫描状态变化；手指按下时实测首字节
+	 * 从 0x40 变为 0x44，不能按固定值比较。
+	 */
+	if (buf[0] != 0xff || buf[1] != 0xff || !(buf[2] & 0x40))
+		return false;
+
+	/* 状态字校验：byte2 的 bit6 为帧类型标志，四字节求和低 8 位为 0 */
+	return (u8)((buf[2] & 0xBF) + buf[3] + buf[4] + buf[5]) == 0;
+}
+
+/*
+ * 判定一次 0x20 读取的数据能否直接用于解算。状态字有效但节点整体
+ * 偏离基线时，IC 正处于启动校准阶段，暂态在数秒内自行结束。
+ */
+bool nvt_frame_valid(const u8 *buf)
+{
+	unsigned int i, near = 0;
+
+	if (!nvt_status_valid(buf))
+		return false;
+
+	for (i = 0; i < NVT_FRAME_NODES; i++) {
+		s16 delta = (s16)(get_unaligned_le16(buf +
+						     NVT_FRAME_NODE_OFFSET +
+						     i * 2) -
+				  NVT_NODE_BASELINE);
+
+		if (delta >= -NVT_AFE_WINDOW && delta <= NVT_AFE_WINDOW)
+			near++;
+	}
+
+	return near * 100 >= NVT_FRAME_NODES * NVT_AFE_VALID_PCT;
+}
+
+/*
+ * 笔扫描帧判定。状态字校验通过只说明 AFE 正在输出帧，手指电容帧与
+ * 笔扫描帧都会通过；笔帧在节点流开头带 a5 5a 5a a5 同步字，手指帧
+ * 不带。读取长度不足时无法检查同步字，按手指帧处理。
+ *
+ * 早期实现用状态字第 5 字节等于 0x06 判定，手指帧与笔帧该字节相同，
+ * 导致所有帧进入笔路径、手指触摸整体失效，不得沿用。
+ */
+bool nvt_pen_frame(const u8 *buf, unsigned int len)
+{
+	/* 先确认长度覆盖状态字与同步字，再读取缓冲区 */
+	if (len < NVT_FRAME_NODE_OFFSET + NVT_PEN_SYNC_LEN)
+		return false;
+
+	if (!nvt_status_valid(buf))
+		return false;
+
+	return buf[NVT_FRAME_NODE_OFFSET] == NVT_PEN_SYNC0 &&
+	       buf[NVT_FRAME_NODE_OFFSET + 1] == NVT_PEN_SYNC1 &&
+	       buf[NVT_FRAME_NODE_OFFSET + 2] == NVT_PEN_SYNC1 &&
+	       buf[NVT_FRAME_NODE_OFFSET + 3] == NVT_PEN_SYNC0;
+}
+
+/* 笔帧节点按节点编号读取，节点 0 位于帧偏移 12。 */
+static u16 nvt_pen_node(const u8 *buf, unsigned int node)
+{
+	return get_unaligned_le16(buf + NVT_PEN_NODE_OFFSET + node * 2);
+}
+
+/*
+ * 线峰值细分。线号 × 1024 + 512 作为槽中心，用相邻两线的峰值插值，
+ * 返回 1/16 线号单位的 q16，避免内核浮点运算。
+ */
+static s64 nvt_pen_q16(const u16 *vals, unsigned int count)
+{
+	unsigned int i, best = 0;
+	s64 q16;
+
+	for (i = 1; i < count; i++)
+		if (vals[i] > vals[best])
+			best = i;
+
+	q16 = ((s64)best * 1024 + 512) << 4;
+	if (best > 0 && best + 1 < count) {
+		unsigned int peak = vals[best];
+		unsigned int left = vals[best - 1];
+		unsigned int right = vals[best + 1];
+		unsigned int lo = min(left, right);
+		unsigned int den = peak - lo;
+
+		if (den) {
+			s64 step16 = ((s64)(max(left, right) - lo) << 14) /
+				     den;
+
+			q16 += right >= left ? step16 / 2 : -step16 / 2;
+		}
+	}
+
+	return q16;
+}
+
+/*
+ * 在 4 个相位中选择幅度最大的一个。节点值本身就是正增量，振幅取
+ * 相位内最大值，与厂商 final_model.py 的选择方式一致。
+ */
+static bool nvt_pen_y_track(const u8 *buf, unsigned int base,
+			    s64 *q16, unsigned int *amp)
+{
+	u16 vals[NVT_PEN_Y_SLOTS];
+	unsigned int phase, best_phase = 0, best_amp = 0, i;
+
+	for (phase = 0; phase < NVT_PEN_Y_PHASES; phase++) {
+		unsigned int peak = 0;
+
+		for (i = 0; i < NVT_PEN_Y_SLOTS; i++) {
+			u16 v = nvt_pen_node(buf, base + phase +
+					     i * NVT_PEN_Y_STRIDE);
+
+			if (v > peak)
+				peak = v;
+		}
+		if (peak > best_amp) {
+			best_amp = peak;
+			best_phase = phase;
+		}
+	}
+
+	if (!best_amp)
+		return false;
+
+	for (i = 0; i < NVT_PEN_Y_SLOTS; i++)
+		vals[i] = nvt_pen_node(buf, base + best_phase +
+				       i * NVT_PEN_Y_STRIDE);
+
+	*q16 = nvt_pen_q16(vals, NVT_PEN_Y_SLOTS);
+	*amp = best_amp;
+	return true;
+}
+
+/*
+ * 由 q16 换算面板像素。系数来自 HarmonyOS 侧 1599 帧真值拟合：
+ * X raw = 0.390453·q + 1205.46，Y raw = 0.408203·q − 297.45，
+ * 面板像素为 raw / 8。常量整体放大 128000000 倍做整数除法。
+ *
+ * X 窗口起点比厂商标定脚本早 3 个节点，同一个物理线号的 q 大 3072，
+ * 截距相应减去 0.390453 × 3072，得到 5.96。
+ */
+static int nvt_pen_x_px(s64 q16, u32 max)
+{
+	s64 px = (390453LL * q16 + 95814144LL) / 128000000LL;
+
+	return clamp_val(px, 0, max - 1);
+}
+
+static int nvt_pen_y_px(s64 q16, u32 max)
+{
+	s64 px = (408203LL * q16 - 4759200000LL) / 128000000LL;
+
+	return clamp_val(px, 0, max - 1);
+}
+
+/*
+ * 解算一帧笔扫描数据并上报悬浮坐标。笔帧与手指帧在中断中二选一，
+ * 这里只做坐标与 BTN_TOOL_PEN，压力与按键由蓝牙链路在合并层提供。
+ */
+bool nvt_process_pen_frame(struct nvt_data *ts, unsigned int len)
+{
+	const u8 *buf = ts->rx_buf;
+	u16 xvals[NVT_PEN_X_LINES];
+	unsigned int i, amp0, amp1;
+	s64 xq, yq0, yq1, yq;
+	int x, y;
+
+	if (len < NVT_PEN_FRAME_LEN || !ts->pen_input)
+		return false;
+
+	for (i = 0; i < NVT_PEN_X_LINES; i++)
+		xvals[i] = nvt_pen_node(buf, NVT_PEN_X_OFF + i);
+	xq = nvt_pen_q16(xvals, NVT_PEN_X_LINES);
+
+	if (!nvt_pen_y_track(buf, NVT_PEN_Y_BASE0, &yq0, &amp0) ||
+	    !nvt_pen_y_track(buf, NVT_PEN_Y_BASE1, &yq1, &amp1))
+		return false;
+
+	/* 两组 Y 线数据按幅度加权融合 */
+	if (amp0 + amp1)
+		yq = div_s64(yq0 * amp0 + yq1 * amp1, amp0 + amp1);
+	else
+		yq = yq0;
+
+	x = nvt_pen_x_px(xq, ts->x_max);
+	y = nvt_pen_y_px(yq, ts->y_max);
+
+	/*
+	 * 笔快速离开时上行信号衰减，峰值可能跳到噪声线上，出现单帧
+	 * 数百像素的假跳变。以 130 Hz 以上的帧率，真实笔尖单帧不可能
+	 * 移动 300 像素；超过门限时保留上一个有效坐标，等待信号恢复。
+	 *
+	 * 跳变帧不刷新 pen_last：噪声帧持续到达时保持时间仍会耗尽，
+	 * 由调用方抬起悬浮状态，避免旧坐标长期滞留。
+	 */
+	if (ts->pen_active &&
+	    (abs(x - ts->pen_x) > NVT_PEN_JUMP_LIMIT ||
+	     abs(y - ts->pen_y) > NVT_PEN_JUMP_LIMIT))
+		return true;
+
+	/*
+	 * 悬停期间坐标通常只在小范围内抖动，重复坐标不必刷新；离开
+	 * 后重新进入时必须重新上报 BTN_TOOL_PEN。
+	 */
+	if (!ts->pen_active || x != ts->pen_x || y != ts->pen_y) {
+		input_report_key(ts->pen_input, BTN_TOOL_PEN, 1);
+		input_report_abs(ts->pen_input, ABS_X, x);
+		input_report_abs(ts->pen_input, ABS_Y, y);
+		input_sync(ts->pen_input);
+		ts->pen_x = x;
+		ts->pen_y = y;
+		ts->pen_active = true;
+	}
+
+	ts->pen_last = jiffies;
+	return true;
+}
+
+/* 笔离开后抬起悬浮状态。 */
+void nvt_release_pen(struct nvt_data *ts)
+{
+	if (!ts->pen_active || !ts->pen_input)
+		return;
+
+	input_report_key(ts->pen_input, BTN_TOOL_PEN, 0);
+	input_sync(ts->pen_input);
+	ts->pen_active = false;
+}
+
+/*
+ * 诊断输出：统计当前缓冲区里一帧相对基线的分布，用于判断异常帧究竟是
+ * SRAM 回落数据还是整体直流偏移。通过 dump_frames 参数按需开启。
+ */
+void nvt_dump_frame(const struct nvt_data *ts)
+{
+	const u8 *buf = ts->rx_buf;
+	unsigned int near = 0, below = 0, above = 0;
+	s64 sum = 0;
+	int min = INT_MAX, max = INT_MIN;
+	unsigned int i;
+
+	for (i = 0; i < NVT_FRAME_NODES; i++) {
+		s16 d = (s16)(get_unaligned_le16(buf + NVT_FRAME_NODE_OFFSET +
+						 i * 2) - NVT_NODE_BASELINE);
+
+		sum += d;
+		if (d < min)
+			min = d;
+		if (d > max)
+			max = d;
+		if (d < -NVT_AFE_WINDOW)
+			below++;
+		else if (d > NVT_AFE_WINDOW)
+			above++;
+		else
+			near++;
+	}
+
+	dev_info(&ts->spi->dev,
+		 "frame %02x%02x%02x%02x%02x%02x near=%u below=%u above=%u min=%d max=%d mean=%lld\n",
+		 buf[0], buf[1], buf[2], buf[3], buf[4], buf[5],
+		 near, below, above, min, max, div_s64(sum, NVT_FRAME_NODES));
+
+	dev_info(&ts->spi->dev, "nodes %04x %04x %04x %04x %04x %04x %04x %04x\n",
+		 get_unaligned_le16(buf + NVT_FRAME_NODE_OFFSET),
+		 get_unaligned_le16(buf + NVT_FRAME_NODE_OFFSET + 2),
+		 get_unaligned_le16(buf + NVT_FRAME_NODE_OFFSET + 4),
+		 get_unaligned_le16(buf + NVT_FRAME_NODE_OFFSET + 6),
+		 get_unaligned_le16(buf + NVT_FRAME_NODE_OFFSET + 8),
+		 get_unaligned_le16(buf + NVT_FRAME_NODE_OFFSET + 10),
+		 get_unaligned_le16(buf + NVT_FRAME_NODE_OFFSET + 12),
+		 get_unaligned_le16(buf + NVT_FRAME_NODE_OFFSET + 14));
+}
+
+/*
+ * 固件在触摸右边缘时会在第 0 列生成一个与真实触点同一行的小区域。
+ * 第 0 列同时也是真实左边缘所在列，因此不能无条件丢弃；只有同一行
+ * 右侧存在强节点时才判定为鬼影。
+ */
+static bool nvt_edge_ghost(const struct nvt_data *ts, int row_node)
+{
+	int row, col;
+
+	for (row = max(row_node - 2, 0);
+	     row <= min(row_node + 2, NVT_ROWS - 1); row++) {
+		for (col = NVT_COLS - 4; col < NVT_COLS; col++) {
+			int idx = row * NVT_COLS + col;
+
+			if (idx >= NVT_FRAME_NODES)
+				continue;
+			if (ts->delta[idx] > (int)threshold)
+				return true;
+		}
+	}
+
+	return false;
+}
+
+/*
+ * 连通区域内部 8 邻域扩张。每个区域用信号强度加权计算质心，质心以
+ * 1/16 节点为单位，便于跟踪时比较小幅移动。帧尾两个位置没有节点，
+ * 邻居索引越过 NVT_FRAME_NODES 时直接跳过。
+ */
+static int nvt_scan_contacts(struct nvt_data *ts, struct nvt_contact *out)
+{
+	int found = 0;
+	int i;
+
+	bitmap_zero(ts->visited, NVT_FRAME_NODES);
+
+	for (i = 0; i < NVT_FRAME_NODES; i++) {
+		s64 sum_w = 0, sum_x = 0, sum_y = 0;
+		int head = 0, tail = 0;
+		int peak = 0;
+		int area, row_c, col_c, row_node, col_node, edge;
+
+		if (test_bit(i, ts->visited))
+			continue;
+		if (ts->delta[i] <= (int)threshold)
+			continue;
+
+		ts->stack[tail++] = i;
+		set_bit(i, ts->visited);
+
+		while (head < tail) {
+			int idx = ts->stack[head++];
+			int row = idx / NVT_COLS;
+			int col = idx % NVT_COLS;
+			int d = ts->delta[idx];
+
+			sum_w += d;
+			sum_x += (s64)col * d * 16;
+			sum_y += (s64)row * d * 16;
+			if (d > peak)
+				peak = d;
+
+			for (int dr = -1; dr <= 1; dr++) {
+				for (int dc = -1; dc <= 1; dc++) {
+					int nr = row + dr;
+					int nc = col + dc;
+					int nidx;
+
+					if (nr < 0 || nr >= NVT_ROWS ||
+					    nc < 0 || nc >= NVT_COLS)
+						continue;
+					nidx = nr * NVT_COLS + nc;
+					if (nidx >= NVT_FRAME_NODES)
+						continue;
+					if (test_bit(nidx, ts->visited))
+						continue;
+					if (ts->delta[nidx] <= (int)threshold)
+						continue;
+					set_bit(nidx, ts->visited);
+					ts->stack[tail++] = nidx;
+				}
+			}
+		}
+
+		if (found >= NVT_MAX_TOUCH)
+			continue;
+
+		area = tail;
+		row_c = DIV_ROUND_CLOSEST(sum_y, sum_w);
+		col_c = DIV_ROUND_CLOSEST(sum_x, sum_w);
+		row_node = row_c >> 4;
+		col_node = col_c >> 4;
+		edge = min(min(col_node, NVT_COLS - 1 - col_node),
+			   min(row_node, NVT_ROWS - 1 - row_node));
+
+		/* 右边缘触摸产生的第 0 列鬼影，仅在同一行右侧有触点时丢弃 */
+		if (col_node == 0 && area <= (int)edge_ghost_area &&
+		    nvt_edge_ghost(ts, row_node))
+			continue;
+
+		/* 大面积触点：整掌或大面积接触，同时启动碎片抑制窗口 */
+		if (palm_area && area >= (int)palm_area) {
+			ts->palm_blob_seen = true;
+			continue;
+		}
+
+		/* 边缘附近的中等面积触点：握持手掌 */
+		if (palm_edge_area && area >= (int)palm_edge_area &&
+		    edge <= (int)palm_edge_margin)
+			continue;
+
+		out[found].row = row_c;
+		out[found].col = col_c;
+		out[found].area = area;
+		out[found].pressure = min(peak / 16, 255);
+		out[found].major = min(tail * 8, 255);
+		found++;
+	}
+
+	return found;
+}
+
+/*
+ * 分段线性校准：把驱动按等分网格算出的 raw 像素映射到面板像素。
+ * 传感器与显示区的边界不完全重合，节点只覆盖部分边缘，分段映射
+ * 可以在保持内部精度的同时把首末节点延伸到显示边缘。节点由设备树
+ * 按实测结果给出。
+ */
+static u32 nvt_calibrate(u32 v, const u16 *raw, const u16 *map,
+			 unsigned int n, u32 max)
+{
+	s64 out;
+	unsigned int i;
+
+	if (n < 2)
+		return min(v, max);
+
+	if (v <= raw[0]) {
+		out = (s64)map[0] +
+		      div_s64((s64)((s32)map[1] - map[0]) *
+			      ((s64)v - raw[0]),
+			      (s32)raw[1] - raw[0]);
+	} else if (v >= raw[n - 1]) {
+		out = (s64)map[n - 1] +
+		      div_s64((s64)((s32)map[n - 1] - map[n - 2]) *
+			      ((s64)v - raw[n - 1]),
+			      (s32)raw[n - 1] - raw[n - 2]);
+	} else {
+		out = map[0];
+		for (i = 0; i + 1 < n; i++) {
+			if (v <= raw[i + 1]) {
+				out = (s64)map[i] +
+				      div_s64((s64)((s32)map[i + 1] -
+						    map[i]) *
+					      ((s64)v - raw[i]),
+					      (s32)raw[i + 1] - raw[i]);
+				break;
+			}
+		}
+	}
+
+	if (out < 0)
+		out = 0;
+	if (out > max)
+		out = max;
+	return out;
+}
+
+static void nvt_map_coords(struct nvt_data *ts, struct nvt_contact *c)
+{
+	u64 row = c->row;
+	u64 col = c->col;
+	u32 x, y;
+
+	if (!swap_xy) {
+		x = div64_u64(col * ts->x_max, 16ULL * (NVT_COLS - 1));
+		y = div64_u64(row * ts->y_max, 16ULL * (NVT_ROWS - 1));
+		x = nvt_calibrate(x, ts->cal_x_raw, ts->cal_x_map,
+				  ts->ncal_x, ts->x_max - 1);
+		y = nvt_calibrate(y, ts->cal_y_raw, ts->cal_y_map,
+				  ts->ncal_y, ts->y_max - 1);
+	} else {
+		/* 校准节点按默认轴序给出，swap_xy 时不应用 */
+		x = div64_u64(row * ts->x_max, 16ULL * (NVT_ROWS - 1));
+		y = div64_u64(col * ts->y_max, 16ULL * (NVT_COLS - 1));
+	}
+
+	/* swap_xy 分支不经过校准，先把边界收紧到 input 允许的范围 */
+	if (x >= ts->x_max)
+		x = ts->x_max - 1;
+	if (y >= ts->y_max)
+		y = ts->y_max - 1;
+
+	if (invert_x)
+		x = ts->x_max - 1 - x;
+	if (invert_y)
+		y = ts->y_max - 1 - y;
+
+	c->x = x;
+	c->y = y;
+}
+
+static void nvt_report_contacts(struct nvt_data *ts, struct nvt_contact *cur,
+				int count)
+{
+	bool taken[NVT_MAX_TOUCH] = { };
+	int slot_of[NVT_MAX_TOUCH] = { };
+	int i, j;
+
+	for (i = 0; i < count; i++) {
+		int best = -1, best_dist = INT_MAX;
+
+		slot_of[i] = -1;
+		for (j = 0; j < NVT_MAX_TOUCH; j++) {
+			int dist;
+
+			if (!ts->prev[j].used || taken[j])
+				continue;
+			dist = abs(ts->prev[j].row - cur[i].row) +
+			       abs(ts->prev[j].col - cur[i].col);
+			if (dist < best_dist) {
+				best_dist = dist;
+				best = j;
+			}
+		}
+
+		if (best >= 0 && best_dist <= NVT_TRACK_DIST * 16) {
+			slot_of[i] = best;
+			taken[best] = true;
+			cur[i].id = ts->prev[best].id;
+		}
+	}
+
+	for (j = 0; j < NVT_MAX_TOUCH; j++) {
+		if (ts->prev[j].used && !taken[j]) {
+			input_mt_slot(ts->input, j);
+			input_mt_report_slot_state(ts->input, MT_TOOL_FINGER, false);
+			ts->prev[j].used = false;
+		}
+	}
+
+	for (i = 0; i < count; i++) {
+		if (slot_of[i] >= 0)
+			continue;
+		for (j = 0; j < NVT_MAX_TOUCH; j++) {
+			if (ts->prev[j].used || taken[j])
+				continue;
+			slot_of[i] = j;
+			taken[j] = true;
+			cur[i].id = ++ts->next_id;
+			break;
+		}
+	}
+
+	for (i = 0; i < count; i++) {
+		j = slot_of[i];
+		if (j < 0)
+			continue;
+
+		input_mt_slot(ts->input, j);
+		input_mt_report_slot_state(ts->input, MT_TOOL_FINGER, true);
+		input_report_abs(ts->input, ABS_MT_POSITION_X, cur[i].x);
+		input_report_abs(ts->input, ABS_MT_POSITION_Y, cur[i].y);
+		input_report_abs(ts->input, ABS_MT_PRESSURE, cur[i].pressure);
+		input_report_abs(ts->input, ABS_MT_TOUCH_MAJOR, cur[i].major);
+
+		ts->prev[j] = cur[i];
+		ts->prev[j].used = true;
+	}
+
+	input_mt_sync_frame(ts->input);
+	input_sync(ts->input);
+}
+
+void nvt_process_frame(struct nvt_data *ts)
+{
+	struct nvt_contact contacts[NVT_MAX_TOUCH] = { };
+	const u8 *p = ts->rx_buf + NVT_FRAME_NODE_OFFSET;
+	int count, i;
+
+	for (i = 0; i < NVT_FRAME_NODES; i++)
+		ts->delta[i] = (s16)(get_unaligned_le16(p + i * 2) -
+				     NVT_NODE_BASELINE);
+
+	/* 帧尾两个位置没有对应节点，保持为 0 */
+	ts->delta[NVT_FRAME_NODES] = 0;
+	ts->delta[NVT_FRAME_NODES + 1] = 0;
+
+	ts->palm_blob_seen = false;
+	count = nvt_scan_contacts(ts, contacts);
+
+	/*
+	 * 整掌会先形成一个较大的区域，随后碎裂成多个与手指面积相近
+	 * 的小区域。大块出现后的一小段时间内丢弃所有触点，避免碎片
+	 * 逐个被当成轻触上报。
+	 */
+	if (ts->palm_blob_seen) {
+		ts->palm_lock_until = jiffies +
+				      msecs_to_jiffies(NVT_PALM_LOCK_MS);
+		count = 0;
+	} else if (time_before(jiffies, ts->palm_lock_until)) {
+		count = 0;
+	}
+
+	/*
+	 * 触点数量异常多同样按手掌处理，并抑制随后的碎片。
+	 */
+	if (palm_max_contacts && count > (int)palm_max_contacts) {
+		dev_dbg_ratelimited(&ts->spi->dev,
+				    "palm rejected: %d contacts\n", count);
+		ts->palm_lock_until = jiffies +
+				      msecs_to_jiffies(NVT_PALM_LOCK_MS);
+		count = 0;
+	}
+
+	/* 静置时固件仍持续中断，没有触点变化时不再产生空帧事件 */
+	if (!count && !ts->touch_active)
+		return;
+	ts->touch_active = count > 0;
+
+	for (i = 0; i < count; i++)
+		nvt_map_coords(ts, &contacts[i]);
+
+	nvt_report_contacts(ts, contacts, count);
+}
+
+/* AFE 失效时主动抬起所有触点槽位，避免残留按压状态 */
+void nvt_release_contacts(struct nvt_data *ts)
+{
+	bool active = false;
+	int i;
+
+	for (i = 0; i < NVT_MAX_TOUCH; i++) {
+		if (!ts->prev[i].used)
+			continue;
+		input_mt_slot(ts->input, i);
+		input_mt_report_slot_state(ts->input, MT_TOOL_FINGER, false);
+		ts->prev[i].used = false;
+		active = true;
+	}
+
+	if (!active)
+		return;
+
+	input_mt_sync_frame(ts->input);
+	input_sync(ts->input);
+	ts->touch_active = false;
+}
+
+/*
+ * 解析一条分段线性校准属性。格式为成对的
+ * <raw 坐标 面板坐标 ...>，raw 必须严格递增；属性缺失、长度
+ * 非法或 raw 乱序时保持 n = 0，由调用方回退到等分映射。
+ */
+static void nvt_parse_calibration(const struct device *dev, const char *prop,
+				  u16 *raw, u16 *map, unsigned int *n)
+{
+	u32 vals[NVT_CAL_MAX * 2];
+	int count, i;
+
+	*n = 0;
+
+	/* 设备树 cell 为 32 位，读取后按 u16 坐标范围校验 */
+	count = device_property_count_u32(dev, prop);
+	if (count < 4 || count > NVT_CAL_MAX * 2 || (count & 1))
+		return;
+	if (device_property_read_u32_array(dev, prop, vals, count))
+		return;
+
+	for (i = 0; i < count / 2; i++) {
+		if (vals[2 * i] > 0xffff || vals[2 * i + 1] > 0xffff)
+			break;
+		if (i && vals[2 * i] <= vals[2 * i - 2])
+			break;
+		raw[i] = vals[2 * i];
+		map[i] = vals[2 * i + 1];
+	}
+
+	if (i >= 2)
+		*n = i;
+}
+
+void nvt_read_calibration(struct nvt_data *ts)
+{
+	const struct device *dev = &ts->spi->dev;
+
+	nvt_parse_calibration(dev, "novatek,x-calibration",
+			      ts->cal_x_raw, ts->cal_x_map, &ts->ncal_x);
+	nvt_parse_calibration(dev, "novatek,y-calibration",
+			      ts->cal_y_raw, ts->cal_y_map, &ts->ncal_y);
+
+	dev_info(dev, "calibration points: x=%u y=%u\n",
+		 ts->ncal_x, ts->ncal_y);
+}
