+/*
+ * 原厂扬声器通路的启动顺序：TFA DSP 配置、端口拓扑、AFE_COMMON_RX
+ * 校准块。端口拓扑与校准块都需要 AFE 侧先注册设备自定义拓扑表。
+ */
+static void q6afe_tdm_rx_tfa_start(struct q6afe_port *port)
+{
+	struct afe_param_id_set_topology_cfg topo = {
+		.minor_version = AFE_API_VERSION_TOPOLOGY_V1,
+		.topology_id = AFE_TOPOLOGY_ID_TFADSP_RX,
+	};
+	struct q6afe *afe = port->afe;
+	int ret;
+
+	q6afe_send_tfa_cfg(port, "pre-start");
+
+	ret = q6afe_port_set_param_v3(port, &topo, AFE_PARAM_ID_SET_TOPOLOGY,
+				      AFE_MODULE_AUDIO_DEV_INTERFACE,
+				      sizeof(topo));
+	if (ret)
+		dev_info(afe->dev, "port 0x%x topology 0x%x unavailable %d\n",
+			 port->id, topo.topology_id, ret);
+	else
+		dev_info(afe->dev, "port 0x%x topology 0x%x ok\n",
+			 port->id, topo.topology_id);
+
+	ret = q6afe_send_common_rx_cal(port);
+	if (ret)
+		dev_err(afe->dev, "port 0x%x AFE_COMMON_RX failed %d\n",
+			port->id, ret);
+}
