 				       AFE_PARAM_ID_INT_DIGITAL_CDC_CLK_CONFIG,
 				       AFE_MODULE_AUDIO_DEV_INTERFACE,
 				       sizeof(*cfg));
@@ -1306,10 +1627,19 @@
 		break;
 	}
 
+	dev_dbg(port->afe->dev,
+		"sysclk port=0x%x clk_id=0x%x src=%d root=%d freq=%u dir=%d ret=%d\n",
+		port->id, clk_id, clk_src, clk_root, freq, dir, ret);
+
 	return ret;
 }
 EXPORT_SYMBOL_GPL(q6afe_port_set_sysclk);
 
