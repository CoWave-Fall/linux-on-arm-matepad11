+/*
+ * 两组 TFA DSP 配置，内容取自原厂真实播放的 APR 记录。原厂在端口
+ * 启动前发送一遍，端口启动后再补发一遍。
+ */
+static void q6afe_send_tfa_cfg(struct q6afe_port *port, const char *phase)
+{
+	static const u8 tfa_cfg[][9] = {
+		{ 0x00, 0x81, 0x05, 0x06, 0xf6, 0x35, 0x07, 0x35, 0xe7 },
+		{ 0x10, 0x81, 0x05, 0x06, 0xed, 0x69, 0x07, 0x38, 0xfe },
+	};
+	struct q6afe *afe = port->afe;
+	int ret, i;
+
+	for (i = 0; i < ARRAY_SIZE(tfa_cfg); i++) {
+		ret = q6afe_port_set_param_v3(port, (void *)tfa_cfg[i],
+					      AFE_PARAM_ID_TFADSP_RX_CFG,
+					      AFE_MODULE_ID_TFADSP_RX,
+					      sizeof(tfa_cfg[i]));
+		if (ret)
+			dev_err(afe->dev,
+				"AFE TFA cfg %d for port 0x%x failed %d\n",
+				i, port->id, ret);
+	}
+	dev_info(afe->dev, "port 0x%x TFA cfg (%s) done\n",
+		 port->id, phase);
+}
