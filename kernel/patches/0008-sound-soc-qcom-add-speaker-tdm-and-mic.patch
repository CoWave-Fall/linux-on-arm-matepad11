+ * PRI TDM TX 0（0x9001）采集（XML 只打开 `TDMCSE`，`TDMVSE` 为 0，
+ * 因此电压检测样本不发送）。原厂在端口打开时依次下发反馈通路配置
+ * （指向扬声器端口 0x9000）、端口拓扑 0x1000B909 与 AFE_COMMON_TX
+ * 校准块，之后才走通用的硬件延迟、TDM 配置、slot mapping 与启动。
+ *
+ * 这里的失败不判定为端口不可用：采集数据经 ADM 矩阵映射送到 ASM，
+ * 与反馈模块是否配置成功无关，因此逐条记录 DSP 应答后继续。
+ */
+static void q6afe_tdm_tx_vi_prepare(struct q6afe_port *port)
+{
+	struct afe_param_id_set_topology_cfg topo = {
+		.minor_version = AFE_API_VERSION_TOPOLOGY_V1,
+		.topology_id = AFE_TOPOLOGY_ID_TFADSP_TX,
+	};
+	/* 原厂报文 32 字节：minor 1、目标端口、4 通道与通道号 1 至 4 */
+	u32 fb_cfg[8] = { 1, AFE_PORT_ID_PRIMARY_TDM_RX, 4, 1, 2, 3, 4, 0 };
+	struct q6afe *afe = port->afe;
+	int ret;
+
+	ret = q6afe_port_set_param_v3(port, fb_cfg,
+				      AFE_PARAM_ID_FEEDBACK_PATH_CFG,
+				      AFE_MODULE_FEEDBACK, sizeof(fb_cfg));
+	if (ret)
+		dev_err(afe->dev, "port 0x%x feedback path cfg failed %d\n",
+			port->id, ret);
+	else
+		dev_info(afe->dev, "port 0x%x feedback path cfg ok\n",
+			 port->id);
+
+	ret = q6afe_port_set_param_v3(port, &topo, AFE_PARAM_ID_SET_TOPOLOGY,
+				      AFE_MODULE_AUDIO_DEV_INTERFACE,
+				      sizeof(topo));
+	if (ret)
+		dev_err(afe->dev, "port 0x%x topology 0x%x failed %d\n",
+			port->id, topo.topology_id, ret);
+	else
+		dev_info(afe->dev, "port 0x%x topology 0x%x ok\n",
+			 port->id, topo.topology_id);
+
+	q6afe_send_common_tx_cal(port);
+}
