+/*
+ * 把固件块复制进连续的 DMA 缓冲，再通过 AFE 服务的共享内存映射
+ * 命令取得 DSP 侧句柄。调用方随后在命令里给出物理地址与句柄，
+ * DSP 按该地址读取块内容。缓冲区在驱动生命周期内保持有效。
+ */
+static int q6afe_shared_mem_map(struct q6afe *afe,
+				struct q6afe_shared_mem *mem, const char *name)
+{
+	struct afe_svc_cmd_shared_mem_map_regions *cmd;
+	struct afe_shared_map_region_payload *region;
+	const struct firmware *fw;
+	struct apr_pkt *pkt;
+	int ret, pkt_size;
+
+	if (mem->mapped)
+		return 0;
+
+	/* 与 DSP 之间的共享内存地址高 32 位带 SMMU SID 编码 */
+	ret = q6core_smmu_sid(afe->dev, &mem->msw);
+	if (ret) {
+		dev_err(afe->dev, "%s SMMU SID unavailable %d\n",
+			name, ret);
+		return ret;
+	}
+
+	ret = request_firmware(&fw, name, afe->dev);
+	if (ret) {
+		dev_err(afe->dev, "firmware %s unavailable %d\n",
+			name, ret);
+		return ret;
+	}
+
+	mem->payload_size = fw->size;
+	mem->map_size = ALIGN(fw->size, SZ_4K);
+	/*
+	 * DSP 经 ADSP 的 SMMU 流访问这块内存，地址必须由 DMA API 分配，
+	 * IOMMU 才会为它建立映射。probe 中的 of_dma_configure() 已按设备
+	 * 树的 iommus 配置好流，这里取到的 paddr 是 DSP 可翻译的 IOVA。
+	 */
+	mem->vaddr = dma_alloc_coherent(afe->dev, mem->map_size, &mem->paddr,
+					GFP_KERNEL);
+	if (!mem->vaddr) {
+		dev_err(afe->dev, "alloc %s failed, size %zu\n",
+			name, mem->map_size);
+		release_firmware(fw);
+		return -ENOMEM;
+	}
+	memcpy(mem->vaddr, fw->data, fw->size);
+	release_firmware(fw);
+
+	pkt_size = APR_HDR_SIZE + sizeof(*cmd) + sizeof(*region);
+	void *p __free(kfree) = kzalloc(pkt_size, GFP_KERNEL);
+	if (!p) {
+		dma_free_coherent(afe->dev, mem->map_size, mem->vaddr,
+				  mem->paddr);
+		mem->vaddr = NULL;
+		return -ENOMEM;
+	}
+
+	pkt = p;
+	cmd = p + APR_HDR_SIZE;
+	region = p + APR_HDR_SIZE + sizeof(*cmd);
+
+	pkt->hdr.hdr_field = APR_HDR_FIELD(APR_MSG_TYPE_SEQ_CMD,
+					   APR_HDR_LEN(APR_HDR_SIZE),
+					   APR_PKT_VER);
+	pkt->hdr.pkt_size = pkt_size;
+	pkt->hdr.token = AFE_CLK_TOKEN;
+	pkt->hdr.opcode = AFE_SERVICE_CMD_SHARED_MEM_MAP_REGIONS;
+
+	cmd->mem_pool_id = ADSP_MEMORY_MAP_SHMEM8_4K_POOL;
+	cmd->num_regions = 1;
+	cmd->property_flag = 0;
+
+	region->shm_addr_lsw = lower_32_bits(mem->paddr);
+	region->shm_addr_msw = mem->msw;
+	region->mem_size_bytes = mem->map_size;
+
+	afe->mmap_handle = 0;
+	ret = afe_apr_send_pkt(afe, pkt, NULL,
+			       AFE_SERVICE_CMD_SHARED_MEM_MAP_REGIONS);
+	if (ret) {
+		dev_err(afe->dev, "map %s failed %d, paddr %pad size %zu\n",
+			name, ret, &mem->paddr, mem->map_size);
+		dma_free_coherent(afe->dev, mem->map_size, mem->vaddr,
+				  mem->paddr);
+		mem->vaddr = NULL;
+		return ret;
+	}
+
+	mem->map_handle = afe->mmap_handle;
+	mem->mapped = true;
+	dev_info(afe->dev, "mapped %s size=%zu handle=0x%x\n",
+		 name, mem->payload_size, mem->map_handle);
+	return 0;
+}
+
+/*
+ * 把共享内存块作为带外 SET_PARAM_V3 下发。DSP 按报文里的地址直接
+ * 读取块内容，报文只给出长度，不追加参数头。
+ */
+static int q6afe_send_shm_block(struct q6afe_port *port,
+				struct q6afe_shared_mem *mem, const char *fw,
+				const char *name)
+{
+	struct q6afe *afe = port->afe;
+	struct afe_port_cmd_set_param_v3 *param;
+	struct apr_pkt *pkt;
+	int ret, pkt_size;
+
+	ret = q6afe_shared_mem_map(afe, mem, fw);
+	if (ret)
+		return ret;
+
+	pkt_size = APR_HDR_SIZE + sizeof(*param);
+	void *p __free(kfree) = kzalloc(pkt_size, GFP_KERNEL);
+	if (!p)
+		return -ENOMEM;
+
+	pkt = p;
+	param = p + APR_HDR_SIZE;
+
+	pkt->hdr.hdr_field = APR_HDR_FIELD(APR_MSG_TYPE_SEQ_CMD,
+					   APR_HDR_LEN(APR_HDR_SIZE),
+					   APR_PKT_VER);
+	pkt->hdr.pkt_size = pkt_size;
+	pkt->hdr.token = port->token;
+	pkt->hdr.opcode = AFE_PORT_CMD_SET_PARAM_V3;
+
+	param->port_id = port->id;
+	param->reserved = 0;
+	param->payload_address_lsw = lower_32_bits(mem->paddr);
+	param->payload_address_msw = mem->msw;
+	param->mem_map_handle = mem->map_handle;
+	param->payload_size = mem->payload_size;
+
+	ret = afe_apr_send_pkt(afe, pkt, port, AFE_PORT_CMD_SET_PARAM_V3);
+	if (ret)
+		dev_err(afe->dev, "port 0x%x %s block failed %d\n",
+			port->id, name, ret);
+	else
+		dev_info(afe->dev, "port 0x%x %s %zu bytes ok\n",
+			 port->id, name, mem->payload_size);
+
+	return ret;
+}
+
+/*
+ * AFE_COMMON_RX 校准块（acdb 210、48 kHz）。块内已按实例标识参数头
+ * 逐条排列，带外发送时只给出块长度，不再追加参数头。
+ */
+static int q6afe_send_common_rx_cal(struct q6afe_port *port)
+{
+	return q6afe_send_shm_block(port, &port->afe->common_rx_mem,
+				    Q6AFE_FW_COMMON_RX, "AFE_COMMON_RX");
+}
+
+/*
+ * AFE_COMMON_TX 校准块（acdb 102、8 kHz、path 1）。原厂在 TX 端口
+ * 打开时下发，内容为 0x1000b912 与 0x1000b920 两个拓扑编号。
+ */
+static int q6afe_send_common_tx_cal(struct q6afe_port *port)
+{
+	return q6afe_send_shm_block(port, &port->afe->common_tx_mem,
+				    Q6AFE_FW_COMMON_TX, "AFE_COMMON_TX");
+}
