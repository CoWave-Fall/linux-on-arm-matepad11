+/*
+ * 把固件块复制进连续的 DMA 缓冲，并通过 ADM 服务的共享内存映射命令
+ * 取得 DSP 侧句柄。缓冲区在驱动生命周期内保持有效。
+ */
+static int q6adm_shared_mem_map(struct q6adm *adm,
+				struct q6adm_shared_mem *mem, const char *name)
+{
+	struct q6adm_cmd_shared_mem_map_regions *cmd;
+	struct q6adm_shared_map_region_payload *region;
+	const struct firmware *fw;
+	struct apr_pkt *pkt;
+	int ret, pkt_size;
+
+	if (mem->mapped)
+		return 0;
+
+	/* 与 DSP 之间的共享内存地址高 32 位带 SMMU SID 编码 */
+	ret = q6core_smmu_sid(adm->dev, &mem->msw);
+	if (ret) {
+		dev_err(adm->dev, "%s SMMU SID unavailable %d\n",
+			name, ret);
+		return ret;
+	}
+
+	ret = request_firmware(&fw, name, adm->dev);
+	if (ret) {
+		dev_err(adm->dev, "firmware %s unavailable %d\n",
+			name, ret);
+		return ret;
+	}
+
+	mem->payload_size = fw->size;
+	mem->map_size = ALIGN(fw->size, SZ_4K);
+	/*
+	 * DSP 经 ADSP 的 SMMU 流访问这块内存，地址必须由 DMA API 分配。
+	 * of_dma_configure() 已按设备树配置好流，paddr 是 DSP 可翻译的
+	 * IOVA。
+	 */
+	mem->vaddr = dma_alloc_coherent(adm->dev, mem->map_size, &mem->paddr,
+					GFP_KERNEL);
+	if (!mem->vaddr) {
+		dev_err(adm->dev, "cannot allocate %s, size %zu\n",
+			name, mem->map_size);
+		release_firmware(fw);
+		return -ENOMEM;
+	}
+	memcpy(mem->vaddr, fw->data, fw->size);
+	release_firmware(fw);
+
+	pkt_size = APR_HDR_SIZE + sizeof(*cmd) + sizeof(*region);
+	void *p __free(kfree) = kzalloc(pkt_size, GFP_KERNEL);
+	if (!p) {
+		dma_free_coherent(adm->dev, mem->map_size, mem->vaddr,
+				  mem->paddr);
+		mem->vaddr = NULL;
+		return -ENOMEM;
+	}
+
+	pkt = p;
+	cmd = p + APR_HDR_SIZE;
+	region = p + APR_HDR_SIZE + sizeof(*cmd);
+
+	pkt->hdr.hdr_field = APR_HDR_FIELD(APR_MSG_TYPE_SEQ_CMD,
+					   APR_HDR_LEN(APR_HDR_SIZE),
+					   APR_PKT_VER);
+	pkt->hdr.pkt_size = pkt_size;
+	pkt->hdr.token = 0;
+	pkt->hdr.opcode = ADM_CMD_SHARED_MEM_MAP_REGIONS;
+
+	cmd->mem_pool_id = ADSP_MEMORY_MAP_SHMEM8_4K_POOL;
+	cmd->num_regions = 1;
+	cmd->property_flag = 0;
+
+	region->shm_addr_lsw = lower_32_bits(mem->paddr);
+	region->shm_addr_msw = mem->msw;
+	region->mem_size_bytes = mem->map_size;
+
+	mutex_lock(&adm->lock);
+	adm->topo_result.opcode = 0;
+	adm->topo_result.status = 0;
+	adm->mmap_handle = 0;
+
+	ret = apr_send_pkt(adm->apr, pkt);
+	if (ret < 0) {
+		dev_err(adm->dev, "map %s send failed %d\n", name, ret);
+		mutex_unlock(&adm->lock);
+		goto free_buf;
+	}
+
+	ret = wait_event_timeout(adm->topo_wait,
+			(adm->topo_result.opcode ==
+			 ADM_CMDRSP_SHARED_MEM_MAP_REGIONS) ||
+			(adm->topo_result.opcode ==
+			 ADM_CMD_SHARED_MEM_MAP_REGIONS),
+			msecs_to_jiffies(TIMEOUT_MS));
+	if (!ret) {
+		dev_err(adm->dev, "map %s timed out\n", name);
+		ret = -ETIMEDOUT;
+		mutex_unlock(&adm->lock);
+		goto free_buf;
+	}
+
+	if (adm->topo_result.opcode != ADM_CMDRSP_SHARED_MEM_MAP_REGIONS) {
+		dev_err(adm->dev, "map %s rejected, status %d\n",
+			name, adm->topo_result.status);
+		ret = -EINVAL;
+		mutex_unlock(&adm->lock);
+		goto free_buf;
+	}
+
+	mem->map_handle = adm->mmap_handle;
+	mem->mapped = true;
+	mutex_unlock(&adm->lock);
+
+	dev_info(adm->dev, "mapped %s size=%zu handle=0x%x\n",
+		 name, mem->payload_size, mem->map_handle);
+	return 0;
+
+free_buf:
+	dma_free_coherent(adm->dev, mem->map_size, mem->vaddr, mem->paddr);
+	mem->vaddr = NULL;
+	return ret;
+}
+
+static int q6adm_send_pp_block(struct q6adm *adm, struct q6copp *copp,
+			       struct q6adm_shared_mem *mem, const char *name)
+{
+	struct q6adm_cmd_set_pp_params *pp;
+	struct apr_pkt *pkt;
+	int ret, pkt_size = APR_HDR_SIZE + sizeof(*pp);
+
+	void *p __free(kfree) = kzalloc(pkt_size, GFP_KERNEL);
+	if (!p)
+		return -ENOMEM;
+
+	pkt = p;
+	pp = p + APR_HDR_SIZE;
+
+	pkt->hdr.hdr_field = APR_HDR_FIELD(APR_MSG_TYPE_SEQ_CMD,
+					   APR_HDR_LEN(APR_HDR_SIZE),
+					   APR_PKT_VER);
+	pkt->hdr.pkt_size = pkt_size;
+	pkt->hdr.src_port = q6afe_get_port_id(copp->afe_port);
+	pkt->hdr.dest_port = copp->id;
+	pkt->hdr.token = copp->afe_port << 16 | copp->copp_idx;
+	pkt->hdr.opcode = ADM_CMD_SET_PP_PARAMS_V6;
+
+	pp->payload_addr_lsw = lower_32_bits(mem->paddr);
+	pp->payload_addr_msw = mem->msw;
+	pp->mem_map_handle = mem->map_handle;
+	pp->payload_size = mem->payload_size;
+
+	/*
+	 * q6adm_apr_send_copp_pkt() 成功时返回剩余 jiffies，只有负值才是
+	 * 失败；这里统一换算成 0。
+	 */
+	ret = q6adm_apr_send_copp_pkt(adm, copp, pkt, 0);
+	if (ret < 0) {
+		dev_err(adm->dev, "ADM %s block failed %d\n", name, ret);
+		return ret;
+	}
+
+	dev_info(adm->dev, "ADM %s %zu bytes ok\n", name,
+		 mem->payload_size);
+
+	return 0;
+}
