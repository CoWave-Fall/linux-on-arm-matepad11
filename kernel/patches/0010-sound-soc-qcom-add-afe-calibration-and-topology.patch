+	send_ret = apr_send_pkt(core->adev, (struct apr_pkt *)&unmap);
+	dev_info(dev, "Q6CORE unmap send ret=%d\n", send_ret);
+	if (send_ret < 0) {
+		dev_err(dev, "CORE unmap send failed\n");
+		if (!ret)
+			ret = -EIO;
+		goto unlock;
+	}
+
+	if (!wait_event_timeout(core->wait, core->topo_rsp_done,
+				msecs_to_jiffies(Q6_TOPO_LOAD_TIMEOUT_MS))) {
+		dev_err(dev, "CORE unmap timed out\n");
+		if (!ret)
+			ret = -ETIMEDOUT;
+		goto unlock;
+	}
+
+	if (core->topo_rsp_status) {
+		dev_err(dev, "CORE unmap rejected, status %u\n",
+			core->topo_rsp_status);
+		if (!ret)
+			ret = -EIO;
+	}
+
+unlock:
+	mutex_unlock(&core->lock);
+	kfree(map);
+free_buf:
+	dma_free_coherent(dev, map_size, vaddr, paddr);
+	return ret;
+}
