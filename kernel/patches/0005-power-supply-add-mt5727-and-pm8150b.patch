+	{ 3530000, 18 },
+	{ 3450000, 9 },
+	{ 3400000, 3 },
+	{ 3300000, 0 },
+};
+
+static int pm8150b_read(struct pm8150b_battery *batt, u32 reg, unsigned int *val)
+{
+	return regmap_read(batt->regmap, reg, val);
+}
+
+static int pm8150b_ima_wait_ready(struct pm8150b_battery *batt)
+{
+	unsigned int val;
+	int i, ret;
+
+	for (i = 0; i < 50; i++) {
+		ret = pm8150b_read(batt, FG_IMA_OPR_STS, &val);
+		if (ret)
+			return ret;
+		if (val & FG_IMA_IACS_RDY)
+			return 0;
+		usleep_range(3000, 3500);
+	}
+
+	return -ETIMEDOUT;
+}
+
+/*
+ * 读取 FG SRAM 的一个 16 位字。IMA 访问需要先申请总线，再设置地址，
+ * 等待硬件就绪后读取两个数据字节。整个过程用 ima_lock 串行化，避免
+ * 与控制算法或其他属性读取互相打断。
+ */
+static int pm8150b_ima_read_word(struct pm8150b_battery *batt, u16 word,
+				 u16 *value)
+{
+	unsigned int val, lo, hi;
+	int i, ret;
+
+	mutex_lock(&batt->ima_lock);
+
+	for (i = 0; i < 8; i++) {
+		ret = pm8150b_read(batt, FG_MEM_INTF_CFG, &val);
+		if (ret)
+			goto out;
+		if (!(val & FG_MEM_ACCESS_REQ))
+			break;
+		usleep_range(2000, 2500);
+	}
+	if (i == 8) {
+		ret = -EBUSY;
+		goto out;
+	}
+
+	ret = regmap_write(batt->regmap, FG_MEM_INTF_CFG,
+			   FG_MEM_ACCESS_REQ | FG_MEM_IACS_SLCT);
+	if (ret)
+		goto out;
+
+	ret = regmap_update_bits(batt->regmap, FG_IMA_CTL, FG_IMA_CTL_MASK, 0);
+	if (ret)
+		goto release;
+
+	ret = pm8150b_ima_wait_ready(batt);
+	if (ret)
+		goto release;
+
+	ret = regmap_write(batt->regmap, FG_IMA_ADDR_LSB, word & 0xff);
+	if (ret)
+		goto release;
+	ret = regmap_write(batt->regmap, FG_IMA_ADDR_MSB, word >> 8);
+	if (ret)
+		goto release;
+
+	ret = pm8150b_ima_wait_ready(batt);
+	if (ret)
+		goto release;
+
+	ret = pm8150b_read(batt, FG_IMA_RD_DATA0, &lo);
+	if (ret)
+		goto release;
+	ret = pm8150b_read(batt, FG_IMA_RD_DATA1, &hi);
+	if (ret)
+		goto release;
+
+	ret = pm8150b_read(batt, FG_IMA_EXP_STS, &val);
+	if (ret)
+		goto release;
+	if (val) {
+		dev_warn_ratelimited(batt->dev, "IMA read error: 0x%02x\n", val);
+		ret = -EIO;
+		goto release;
+	}
+
+	*value = lo | (hi << 8);
+	ret = 0;
+
+release:
+	regmap_write(batt->regmap, FG_MEM_INTF_CFG, 0);
+out:
+	mutex_unlock(&batt->ima_lock);
+	return ret;
+}
+
+/*
+ * FG 的电压与电流寄存器各有一份影子副本，两份读数一致才说明
+ * 硬件完成了本次更新。
+ */
+static int pm8150b_read_shadowed_u16(struct pm8150b_battery *batt,
+				     u32 lsb_reg, u32 msb_reg,
+				     u32 cp_lsb_reg, u32 cp_msb_reg,
+				     u16 *value)
+{
+	unsigned int lsb, msb, cp_lsb, cp_msb;
+	int i, ret;
+
+	for (i = 0; i < 3; i++) {
+		ret = pm8150b_read(batt, lsb_reg, &lsb);
+		if (ret)
+			return ret;
+		ret = pm8150b_read(batt, msb_reg, &msb);
+		if (ret)
+			return ret;
+		ret = pm8150b_read(batt, cp_lsb_reg, &cp_lsb);
+		if (ret)
+			return ret;
+		ret = pm8150b_read(batt, cp_msb_reg, &cp_msb);
+		if (ret)
+			return ret;
+
+		if (lsb == cp_lsb && msb == cp_msb) {
+			*value = (msb << 8) | lsb;
+			return 0;
+		}
+	}
+
+	return -EIO;
+}
+
+static int pm8150b_read_voltage_uv(struct pm8150b_battery *batt, int *voltage_uv)
+{
+	u16 raw;
+	int ret, val;
+
+	ret = pm8150b_read_shadowed_u16(batt, FG_INFO_VBAT_LSB,
+					FG_INFO_VBAT_MSB, FG_INFO_VBAT_CP_LSB,
+					FG_INFO_VBAT_CP_MSB, &raw);
+	if (!ret) {
+		*voltage_uv = div_u64((u64)raw * FG_VBAT_NUMR, 1000);
+		return 0;
+	}
+
+	ret = iio_read_channel_processed(batt->vbat_chan, &val);
+	if (ret < 0)
+		return ret;
+
+	*voltage_uv = val;
+	return 0;
+}
+
+static int pm8150b_read_current_ua(struct pm8150b_battery *batt, int *current_ua)
+{
+	u16 raw;
+	int ret;
+
+	ret = pm8150b_read_shadowed_u16(batt, FG_INFO_IBAT_LSB,
+					FG_INFO_IBAT_MSB, FG_INFO_IBAT_CP_LSB,
+					FG_INFO_IBAT_CP_MSB, &raw);
+	if (ret)
+		return ret;
+
+	*current_ua = div_s64((s64)(s16)raw * FG_IBAT_NUMR, 1000);
+	return 0;
+}
+
+static int pm8150b_voltage_to_capacity(int voltage_uv)
+{
+	int i;
+
+	for (i = 0; i < ARRAY_SIZE(pm8150b_voltage_curve); i++) {
+		if (voltage_uv >= pm8150b_voltage_curve[i].voltage_uv)
+			return pm8150b_voltage_curve[i].capacity;
+	}
+
+	return 0;
+}
+
+/*
+ * FG 的单调 SOC 保存在两个影子寄存器中，读到不一致时说明硬件
+ * 正在更新，需要重试。SOC_READY 与算法使能位共同决定该值是否可用。
+ */
+static int pm8150b_read_fg_soc(struct pm8150b_battery *batt, int *soc)
+{
+	unsigned int int_sts, en_ctl;
+	unsigned int lo, hi;
+	int i, ret;
+
+	ret = pm8150b_read(batt, FG_SOC_INT_RT_STS, &int_sts);
+	if (ret)
+		return ret;
+
+	ret = pm8150b_read(batt, FG_SOC_EN_CTL, &en_ctl);
+	if (ret)
+		return ret;
+
+	if (!(int_sts & FG_SOC_READY_BIT) && !(en_ctl & FG_ALG_EN_BIT))
+		return -ENODATA;
+
+	for (i = 0; i < 3; i++) {
+		ret = pm8150b_read(batt, FG_SOC_MONOTONIC_LO, &lo);
+		if (ret)
+			return ret;
+		ret = pm8150b_read(batt, FG_SOC_MONOTONIC_HI, &hi);
+		if (ret)
+			return ret;
+
+		if (lo == hi) {
+			*soc = DIV_ROUND_CLOSEST(lo * 100, FG_SOC_RAW_MAX);
+			return 0;
+		}
+	}
+
+	return -EIO;
+}
+
+static int pm8150b_read_capacity(struct pm8150b_battery *batt, int *capacity)
+{
+	int voltage_uv;
+	int soc;
+	int ret;
+
+	ret = pm8150b_read_fg_soc(batt, &soc);
+	if (!ret) {
+		*capacity = clamp(soc, 0, 100);
+		return 0;
+	}
+
+	ret = pm8150b_read_voltage_uv(batt, &voltage_uv);
+	if (ret)
+		return ret;
+
+	*capacity = pm8150b_voltage_to_capacity(voltage_uv);
+	return 0;
+}
+
+/*
+ * 电池温度只保存在 FG SRAM 的 BATT_TEMP 字中：10 位有符号数，
+ * 每个 LSB 代表 0.25 摄氏度。
+ */
+static int pm8150b_read_temperature(struct pm8150b_battery *batt, int *temp)
+{
+	u16 raw;
+	int ret;
+
+	ret = pm8150b_ima_read_word(batt, FG_SRAM_BATT_TEMP, &raw);
+	if (ret)
+		return ret;
+
+	*temp = sign_extend32(raw, 9) * 100 / 40;
+	return 0;
+}
+
+static int pm8150b_input_present(struct pm8150b_battery *batt, bool *present)
+{
+	unsigned int usbin, dcin, path;
+	int ret;
+
+	ret = pm8150b_read(batt, USBIN_INT_RT_STS, &usbin);
+	if (ret)
+		return ret;
+	ret = pm8150b_read(batt, DCIN_INT_RT_STS, &dcin);
+	if (ret)
+		return ret;
+	ret = pm8150b_read(batt, DCDC_POWER_PATH, &path);
+	if (ret)
+		return ret;
+
+	*present = (usbin & USBIN_PLUGIN_BIT) || (dcin & DCIN_PLUGIN_BIT) ||
+		   (path & (USE_USBIN_BIT | USE_DCIN_BIT));
+	return 0;
+}
+
+static int pm8150b_get_status(struct pm8150b_battery *batt)
+{
+	unsigned int chgr_status, chgr_enable;
+	int capacity;
+	bool input;
+	int ret;
+
+	ret = pm8150b_input_present(batt, &input);
+	if (ret)
+		return POWER_SUPPLY_STATUS_UNKNOWN;
+
+	ret = pm8150b_read(batt, CHGR_STATUS_1, &chgr_status);
+	if (ret)
+		return POWER_SUPPLY_STATUS_UNKNOWN;
+
+	ret = pm8150b_read(batt, CHGR_ENABLE_CMD, &chgr_enable);
+	if (ret)
+		return POWER_SUPPLY_STATUS_UNKNOWN;
+
+	if (!input)
+		return POWER_SUPPLY_STATUS_DISCHARGING;
+
+	if (!(chgr_enable & CHG_ENABLE_BIT))
+		return POWER_SUPPLY_STATUS_NOT_CHARGING;
+
+	switch (chgr_status & CHGR_STATUS_MASK) {
+	case CHGR_PRE_CHARGE:
+	case CHGR_FULLON_CHARGE:
+	case CHGR_TAPER_CHARGE:
+		return POWER_SUPPLY_STATUS_CHARGING;
+	case CHGR_INHIBIT_CHARGE:
+	case CHGR_TERMINATE_CHARGE:
+	case CHGR_PAUSE_CHARGE:
+	case CHGR_DISABLE_CHARGE:
+		/* 容量读取失败时无法区分满电，按未充电处理 */
+		if (pm8150b_read_capacity(batt, &capacity))
+			return POWER_SUPPLY_STATUS_NOT_CHARGING;
+		return capacity >= 99 ? POWER_SUPPLY_STATUS_FULL :
+					POWER_SUPPLY_STATUS_NOT_CHARGING;
+	default:
+		return POWER_SUPPLY_STATUS_NOT_CHARGING;
+	}
+}
+
+static int pm8150b_get_health(struct pm8150b_battery *batt)
+{
+	unsigned int status7;
+	int temp, ret;
+
+	ret = pm8150b_read_temperature(batt, &temp);
+	if (!ret) {
+		if (temp >= 600)
+			return POWER_SUPPLY_HEALTH_OVERHEAT;
+		if (temp <= -50)
+			return POWER_SUPPLY_HEALTH_COLD;
+		if (temp >= 450)
+			return POWER_SUPPLY_HEALTH_WARM;
+		if (temp <= 100)
+			return POWER_SUPPLY_HEALTH_COOL;
+	}
+
+	ret = pm8150b_read(batt, CHGR_STATUS_7, &status7);
+	if (ret)
+		return POWER_SUPPLY_HEALTH_UNKNOWN;
+
+	if (status7 & BAT_TEMP_TOO_HOT_BIT)
+		return POWER_SUPPLY_HEALTH_OVERHEAT;
+	if (status7 & BAT_TEMP_TOO_COLD_BIT)
+		return POWER_SUPPLY_HEALTH_COLD;
+
+	return POWER_SUPPLY_HEALTH_GOOD;
+}
+
+static int pm8150b_get_capacity_level(struct pm8150b_battery *batt, int capacity)
+{
+	if (capacity >= 95)
+		return POWER_SUPPLY_CAPACITY_LEVEL_FULL;
+	if (capacity >= 70)
+		return POWER_SUPPLY_CAPACITY_LEVEL_HIGH;
+	if (capacity >= 40)
+		return POWER_SUPPLY_CAPACITY_LEVEL_NORMAL;
+	if (capacity >= 15)
+		return POWER_SUPPLY_CAPACITY_LEVEL_LOW;
+	return POWER_SUPPLY_CAPACITY_LEVEL_CRITICAL;
+}
+
+static int pm8150b_battery_get_property(struct power_supply *psy,
+					enum power_supply_property psp,
+					union power_supply_propval *val)
+{
+	struct pm8150b_battery *batt = power_supply_get_drvdata(psy);
+	unsigned int reg;
+	int capacity, voltage_uv, current_ua, temp;
+	int ret;
+
+	switch (psp) {
+	case POWER_SUPPLY_PROP_STATUS:
+		val->intval = pm8150b_get_status(batt);
+		return 0;
+	case POWER_SUPPLY_PROP_PRESENT:
+		ret = pm8150b_read(batt, FG_RRADC_INT_RT_STS, &reg);
+		if (ret)
+			return ret;
+		val->intval = !(reg & RRADC_BATT_MISSING_BIT);
+		return 0;
+	case POWER_SUPPLY_PROP_TECHNOLOGY:
+		val->intval = POWER_SUPPLY_TECHNOLOGY_LION;
+		return 0;
+	case POWER_SUPPLY_PROP_CAPACITY:
+		ret = pm8150b_read_capacity(batt, &capacity);
+		if (ret)
+			return ret;
+		val->intval = capacity;
+		return 0;
+	case POWER_SUPPLY_PROP_CAPACITY_LEVEL:
+		ret = pm8150b_read_capacity(batt, &capacity);
+		if (ret)
+			return ret;
+		val->intval = pm8150b_get_capacity_level(batt, capacity);
+		return 0;
+	case POWER_SUPPLY_PROP_VOLTAGE_NOW:
+		ret = pm8150b_read_voltage_uv(batt, &voltage_uv);
+		if (ret)
+			return ret;
+		val->intval = voltage_uv;
+		return 0;
+	case POWER_SUPPLY_PROP_CURRENT_NOW:
+		ret = pm8150b_read_current_ua(batt, &current_ua);
+		if (ret)
+			return ret;
+		val->intval = current_ua;
+		return 0;
+	case POWER_SUPPLY_PROP_POWER_NOW:
+		ret = pm8150b_read_current_ua(batt, &current_ua);
+		if (ret)
+			return ret;
+		ret = pm8150b_read_voltage_uv(batt, &voltage_uv);
+		if (ret)
+			return ret;
+		val->intval = div_s64((s64)current_ua * voltage_uv, 1000000);
+		return 0;
+	case POWER_SUPPLY_PROP_VOLTAGE_MIN_DESIGN:
+		val->intval = BATT_MIN_MV * 1000;
+		return 0;
+	case POWER_SUPPLY_PROP_VOLTAGE_MAX_DESIGN:
+		val->intval = BATT_MAX_MV * 1000;
+		return 0;
+	case POWER_SUPPLY_PROP_TEMP:
+		ret = pm8150b_read_temperature(batt, &temp);
+		if (ret)
+			return ret;
+		val->intval = temp;
+		return 0;
+	case POWER_SUPPLY_PROP_HEALTH:
+		val->intval = pm8150b_get_health(batt);
+		return 0;
+	case POWER_SUPPLY_PROP_CHARGE_FULL_DESIGN:
+		val->intval = BATT_CHARGE_FULL_UAH;
+		return 0;
+	case POWER_SUPPLY_PROP_CHARGE_FULL:
+		val->intval = BATT_CHARGE_FULL_UAH;
+		return 0;
+	case POWER_SUPPLY_PROP_CHARGE_NOW:
+		ret = pm8150b_read_capacity(batt, &capacity);
+		if (ret)
+			return ret;
+		val->intval = DIV_ROUND_CLOSEST(BATT_CHARGE_FULL_UAH * capacity,
+						100);
+		return 0;
+	case POWER_SUPPLY_PROP_ENERGY_FULL_DESIGN:
+	case POWER_SUPPLY_PROP_ENERGY_FULL:
+		val->intval = DIV_ROUND_CLOSEST_ULL((u64)BATT_CHARGE_FULL_UAH *
+						    BATT_NOMINAL_MV, 1000);
+		return 0;
+	case POWER_SUPPLY_PROP_ENERGY_NOW:
+		ret = pm8150b_read_capacity(batt, &capacity);
+		if (ret)
+			return ret;
+		val->intval = DIV_ROUND_CLOSEST_ULL((u64)BATT_CHARGE_FULL_UAH *
+						    BATT_NOMINAL_MV * capacity,
+						    100000);
+		return 0;
+	default:
+		return -EINVAL;
+	}
+}
+
+static int pm8150b_usb_get_property(struct power_supply *psy,
+				    enum power_supply_property psp,
+				    union power_supply_propval *val)
+{
+	struct pm8150b_battery *batt = power_supply_get_drvdata(psy);
+	bool input;
+	int ret;
+
+	switch (psp) {
+	case POWER_SUPPLY_PROP_ONLINE:
+	case POWER_SUPPLY_PROP_PRESENT:
+		ret = pm8150b_input_present(batt, &input);
+		if (ret)
+			return ret;
+		val->intval = input;
+		return 0;
+	default:
+		return -EINVAL;
+	}
+}
+
+static enum power_supply_property pm8150b_battery_props[] = {
+	POWER_SUPPLY_PROP_STATUS,
+	POWER_SUPPLY_PROP_PRESENT,
+	POWER_SUPPLY_PROP_TECHNOLOGY,
+	POWER_SUPPLY_PROP_CAPACITY,
+	POWER_SUPPLY_PROP_CAPACITY_LEVEL,
+	POWER_SUPPLY_PROP_VOLTAGE_NOW,
+	POWER_SUPPLY_PROP_CURRENT_NOW,
+	POWER_SUPPLY_PROP_POWER_NOW,
+	POWER_SUPPLY_PROP_VOLTAGE_MIN_DESIGN,
+	POWER_SUPPLY_PROP_VOLTAGE_MAX_DESIGN,
+	POWER_SUPPLY_PROP_TEMP,
+	POWER_SUPPLY_PROP_HEALTH,
+	POWER_SUPPLY_PROP_CHARGE_FULL_DESIGN,
+	POWER_SUPPLY_PROP_CHARGE_FULL,
+	POWER_SUPPLY_PROP_CHARGE_NOW,
+	POWER_SUPPLY_PROP_ENERGY_FULL_DESIGN,
+	POWER_SUPPLY_PROP_ENERGY_FULL,
+	POWER_SUPPLY_PROP_ENERGY_NOW,
+};
+
+static enum power_supply_property pm8150b_usb_props[] = {
+	POWER_SUPPLY_PROP_ONLINE,
+	POWER_SUPPLY_PROP_PRESENT,
+};
+
+static const struct power_supply_desc pm8150b_battery_desc = {
+	.name			= "battery",
+	.type			= POWER_SUPPLY_TYPE_BATTERY,
+	.properties		= pm8150b_battery_props,
+	.num_properties		= ARRAY_SIZE(pm8150b_battery_props),
+	.get_property		= pm8150b_battery_get_property,
+};
+
+static const struct power_supply_desc pm8150b_usb_desc = {
+	.name			= "usb",
+	.type			= POWER_SUPPLY_TYPE_USB,
+	.properties		= pm8150b_usb_props,
+	.num_properties		= ARRAY_SIZE(pm8150b_usb_props),
+	.get_property		= pm8150b_usb_get_property,
+};
+
+static int pm8150b_battery_probe(struct platform_device *pdev)
+{
+	struct device *dev = &pdev->dev;
+	struct power_supply_config psy_cfg = { };
+	struct pm8150b_battery *batt;
+
+	batt = devm_kzalloc(dev, sizeof(*batt), GFP_KERNEL);
+	if (!batt)
+		return -ENOMEM;
+
+	batt->dev = dev;
+	mutex_init(&batt->ima_lock);
+	batt->regmap = dev_get_regmap(dev->parent, NULL);
+	if (!batt->regmap)
+		return dev_err_probe(dev, -ENODEV, "parent device has no regmap\n");
+
+	batt->vbat_chan = devm_iio_channel_get(dev, "vbat");
+	if (IS_ERR(batt->vbat_chan))
+		return dev_err_probe(dev, PTR_ERR(batt->vbat_chan),
+				     "cannot get vbat channel\n");
+
+	psy_cfg.drv_data = batt;
+	psy_cfg.fwnode = dev_fwnode(dev);
+
+	batt->battery_psy = devm_power_supply_register(dev, &pm8150b_battery_desc,
+						       &psy_cfg);
+	if (IS_ERR(batt->battery_psy))
+		return dev_err_probe(dev, PTR_ERR(batt->battery_psy),
+				     "failed to register battery power_supply\n");
+
+	batt->usb_psy = devm_power_supply_register(dev, &pm8150b_usb_desc,
+						   &psy_cfg);
+	if (IS_ERR(batt->usb_psy))
+		return dev_err_probe(dev, PTR_ERR(batt->usb_psy),
+				     "failed to register USB power_supply\n");
+
+	platform_set_drvdata(pdev, batt);
+	dev_info(dev, "PM8150B battery and charger registered\n");
+	return 0;
+}
+
+static const struct of_device_id pm8150b_battery_of_match[] = {
+	{ .compatible = "qcom,pm8150b-battery" },
+	{ }
+};
+MODULE_DEVICE_TABLE(of, pm8150b_battery_of_match);
+
+static struct platform_driver pm8150b_battery_driver = {
+	.probe = pm8150b_battery_probe,
+	.driver = {
+		.name = "pm8150b-battery",
+		.of_match_table = pm8150b_battery_of_match,
+	},
+};
+module_platform_driver(pm8150b_battery_driver);
+
+MODULE_DESCRIPTION("Qualcomm PM8150B battery and charger driver");
+MODULE_LICENSE("GPL");
