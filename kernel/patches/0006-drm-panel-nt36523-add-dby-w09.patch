From: CoWave Fall <105500745+CoWave-Fall@users.noreply.github.com>
Subject: [PATCH] drm: panel: nt36523: add Huawei DBY-W09 190_20d panel

Applied to Linux 7.3.1.

Signed-off-by: CoWave Fall <105500745+CoWave-Fall@users.noreply.github.com>

--- a/Documentation/devicetree/bindings/display/panel/novatek,nt36523.yaml
+++ b/Documentation/devicetree/bindings/display/panel/novatek,nt36523.yaml
@@ -19,6 +19,7 @@
     oneOf:
       - items:
           - enum:
+              - huawei,dby-w09-190-20d
               - xiaomi,elish-boe-nt36523
               - xiaomi,elish-csot-nt36523
           - const: novatek,nt36523
@@ -37,6 +38,15 @@
   vddio-supply:
     description: regulator that supplies the I/O voltage
 
+  vci-supply:
+    description: regulator that supplies the analog voltage
+
+  vsp-supply:
+    description: regulator that supplies the positive bias voltage
+
+  vsn-supply:
+    description: regulator that supplies the negative bias voltage
+
 required:
   - compatible
   - reg
--- a/drivers/gpu/drm/panel/panel-novatek-nt36523.c
+++ b/drivers/gpu/drm/panel/panel-novatek-nt36523.c
@@ -28,11 +28,18 @@
 	struct drm_panel panel;
