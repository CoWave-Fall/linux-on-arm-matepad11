From: CoWave Fall <105500745+CoWave-Fall@users.noreply.github.com>
Subject: [PATCH] input: button_kbd: initialize the key state from the boot state

Applied to U-Boot v2026.10.

Signed-off-by: CoWave Fall <105500745+CoWave-Fall@users.noreply.github.com>

--- a/drivers/input/button_kbd.c
+++ b/drivers/input/button_kbd.c
@@ -38,8 +38,11 @@
 
 	uclass_foreach_dev_probe(UCLASS_BUTTON, button_gpio_devp) {
 		struct button_uc_plat *uc_plat = dev_get_uclass_plat(button_gpio_devp);
-		/* Ignore the top-level button node */
-		if (!uc_plat->label)
+		/*
+		 * 只统计同时具备 label 与键码的按钮，与轮询和初始化的
+		 * 筛选条件保持一致。
+		 */
+		if (!uc_plat->label || !button_get_code(button_gpio_devp))
 			continue;
 		debug("Found button %s #%d - %s, probing...\n",
 		      uc_plat->label, i, button_gpio_devp->name);
@@ -63,6 +66,24 @@
 
 	priv->button_size = i;
 	priv->old_state = calloc(i, sizeof(int));
+	if (!priv->old_state)
+		return -ENOMEM;
+
+	/*
+	 * 以启动时的实际状态作为初值。按键在驱动启动前已经处于按下状态时，
+	 * 第一次轮询不会产生多余的按下事件。电源键用于打开 bootmenu 时，
+	 * 这条规则避免菜单刚显示就被 button-kbd 当成 Enter 确认。
+	 */
+	i = 0;
+	uclass_id_foreach_dev(UCLASS_BUTTON, button_gpio_devp, uc) {
+		struct button_uc_plat *uc_plat = dev_get_uclass_plat(button_gpio_devp);
+
+		if (!uc_plat->label || !button_get_code(button_gpio_devp))
+			continue;
+		if (i >= priv->button_size)
+			break;
+		priv->old_state[i++] = button_get_state(button_gpio_devp);
+	}
 
 	return 0;
 }
@@ -83,6 +104,8 @@
 		code = button_get_code(button_gpio_devp);
 		if (!code)
 			continue;
+		if (i >= priv->button_size)
+			break;
 
 		state = button_get_state(button_gpio_devp);
 		state_changed = state != priv->old_state[i];
