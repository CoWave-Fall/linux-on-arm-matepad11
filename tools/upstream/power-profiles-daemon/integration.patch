From: CoWave Fall <105500745+CoWave-Fall@users.noreply.github.com>
Subject: [PATCH] build: add the qcom CPU driver

Wire the Qualcomm qcom-cpufreq-hw driver into the build and the driver
list.

Signed-off-by: CoWave Fall <105500745+CoWave-Fall@users.noreply.github.com>

diff --git a/src/meson.build b/src/meson.build
index 3faed4f..bea162e 100644
--- a/src/meson.build
+++ b/src/meson.build
@@ -93,6 +93,7 @@ sources += [
   'ppd-action-amdgpu-dpm.c',
   'ppd-driver-intel-pstate.c',
   'ppd-driver-amd-pstate.c',
+  'ppd-driver-qcom.c',
   'ppd-driver-cpufreq.c',
   'ppd-driver-platform-profile.c',
   'ppd-driver-placeholder.c',
diff --git a/src/power-profiles-daemon.c b/src/power-profiles-daemon.c
index cf4f230..119ef98 100644
--- a/src/power-profiles-daemon.c
+++ b/src/power-profiles-daemon.c
@@ -143,6 +143,7 @@ static void upower_battery_set_power_changed_reason (PpdApp *, PpdPowerChangedRe
 #include "ppd-driver-platform-profile.h"
 #include "ppd-driver-intel-pstate.h"
 #include "ppd-driver-amd-pstate.h"
+#include "ppd-driver-qcom.h"
 #include "ppd-driver-cpufreq.h"
 #include "ppd-driver-fake.h"

@@ -154,6 +155,7 @@ static GTypeGetFunc objects[] = {
   ppd_driver_platform_profile_get_type,
   ppd_driver_intel_pstate_get_type,
   ppd_driver_amd_pstate_get_type,
+  ppd_driver_qcom_get_type,

   /* Generic profile drivers */
   ppd_driver_cpufreq_get_type,
